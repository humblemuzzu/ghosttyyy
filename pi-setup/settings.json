{
  "lastChangelogVersion": "0.85.1",
  "hideThinkingBlock": true,
  "defaultThinkingLevel": "high",
  "theme": "gruvbox",
  "defaultProvider": "xai",
  "defaultModel": "grok-4.6",
  "skills": [
    "~/.config/agents/skills"
  ],
  "extensions": [
    "~/.pi/agent/extensions/editor",
    "~/.pi/agent/extensions/session-name.ts",
    "~/.pi/agent/extensions/system-prompt.ts",
    "~/.pi/agent/extensions/tools",
    "~/.pi/agent/extensions/command-palette",
    "~/.pi/agent/extensions/session-breakdown.ts",
    "~/.pi/agent/extensions/notify.ts",
    "~/.pi/agent/extensions/mentions.ts"
  ],
  "compaction": {
    "enabled": true
  },
  "enabledModels": [
    "deepseek/deepseek-flash",
    "openai-codex/gpt-5.6-sol",
    "openai-codex/gpt-5.6-terra",
    "openai-codex/gpt-6-astra",
    "openrouter/deepseek/deepseek-v4.1-flash",
    "openrouter/z-ai/glm-5.3-flash",
    "xai/grok-4.5",
    "xai/grok-4.6:high"
  ],
  "steeringMode": "all",
  "followUpMode": "all",
  "doubleEscapeAction": "tree",
  "quietStartup": true,
  "packages": [
    "npm:pi-token-burden",
    "npm:@benvargas/pi-claude-code-use@1.0.5",
    "npm:@marckrenn/pi-sub-bar",
    "https://github.com/davebcn87/pi-autoresearch",
    "npm:pi-tool-display",
    "npm:pi-codex-goal",
    { "source": "npm:pi-mcp-adapter", "skills": [] }
  ],
  "terminal": {
    "clearOnShrink": false,
    "showImages": false
  }
}
