{
  "lastChangelogVersion": "0.82.1",
  "hideThinkingBlock": false,
  "defaultThinkingLevel": "high",
  "theme": "gruvbox",
  "defaultProvider": "anthropic",
  "defaultModel": "claude-opus-5",
  "skills": [
    "~/.config/agents/skills"
  ],
  "extensions": [
    "~/.pi/agent/extensions/editor",
    "~/.pi/agent/extensions/session-name.ts",
    "~/.pi/agent/extensions/tool-harness.ts",
    "~/.pi/agent/extensions/system-prompt.ts",
    "~/.pi/agent/extensions/tools",
    "~/.pi/agent/extensions/command-palette",
    "~/.pi/agent/extensions/session-breakdown.ts",
    "~/.pi/agent/extensions/notify.ts",
    "~/.pi/agent/extensions/todos.ts",
    "~/.pi/agent/extensions/mentions.ts"
  ],
  "compaction": {
    "enabled": true
  },
  "enabledModels": [
    "anthropic/claude-opus-4-8",
    "anthropic/claude-opus-4-6",
    "anthropic/claude-opus-4-7",
    "kimi-coding/kimi-for-coding",
    "kimi-code/kimi-for-coding:high",
    "deepseek/deepseek-v4-pro",
    "deepseek/deepseek-v4-flash",
    "openai-codex/gpt-5.5",
    "sakana/fugu",
    "sakana/fugu-ultra"
  ],
  "steeringMode": "all",
  "followUpMode": "all",
  "doubleEscapeAction": "tree",
  "quietStartup": true,
  "packages": [
    "npm:pi-context",
    "npm:pi-token-burden",
    "npm:@benvargas/pi-claude-code-use",
    "npm:@marckrenn/pi-sub-bar",
    "https://github.com/davebcn87/pi-autoresearch",
    "npm:pi-tool-display",
    "npm:@tomooshi/condensed-milk-pi",
    "npm:pi-codex-goal",
    "npm:pi-mcp-adapter"
  ],
  "terminal": {
    "clearOnShrink": true
  }
}
